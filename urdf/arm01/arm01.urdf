<?xml version="1.0"?>
<!--
================================================================================
arm01 design ledger
================================================================================
Robot      arm01: the 7-DOF MyActuator EtherCAT arm under test (right arm on a
           post stand). Source CAD: "Full Assembly (2).step".
Consumers  Pinocchio (arm_stack model, sim, fits), robot_state_publisher /
           RViz, ros2_control (urdf/arm01/arm01.ros2_control.xacro), Isaac Lab
           (PACE, via `arm export pace`).
Units      metres, kilograms, radians. Meshes are binary STL in metres.

Frames
  base_link  origin at the top centre of the stand's post (CAD (0, 0, 541) mm).
             x forward (CAD -y), y to the robot's left (CAD +x), z up.
  linkN      origin on joint N's axis (at the actuator centre for J1-J5, at
             the wrist pitch pivot for J6/J7). Every link frame is parallel to
             base_link at the zero pose (all joint rpy = 0); joint axes are
             vectors in that frame.
  flange     J7 output face centre, z out along the J7 axis, x toward base -z.
  tool0      tip of the J7PEG probe (the pivot-test probe), z out of the tip,
             x toward base +x.

Zero pose  The CAD pose for every joint except the elbow: the CAD has the
           elbow flexed 24.71 deg, so every link past J4 was rotated back
           about the J4 axis and q4 = 0 is a straight elbow (J5 axis parallel
           to J3). J2 = 0 is the CAD pose, where its hardstop spacer touches
           the J1-J2 front link (lower stop). ASSUMPTION: J1, J3, J5, J6, J7
           zeros at the CAD pose; the zeroing jig defines the real zero.

Joint signs (positive direction; ASSUMPTION, check in `arm bringup`)
  J1 shoulder_pitch  lifts the arm forward/up (+200 deg), back is -80.
  J2 shoulder_roll   abducts the arm away from the body (0 .. +190).
  J3 shoulder_yaw    CCW about the upper-arm axis pointing up to the shoulder.
  J4 elbow           flexes the forearm forward (0 straight .. +130).
  J5 forearm_yaw     CCW about the forearm axis pointing up to the elbow.
  J6 wrist_pitch     flexes the hand forward, same sense as the elbow.
  J7 wrist_yaw       about the axis pointing out of the J7 output face.

Joints (origin = child frame in parent frame, m; axis in parent/child frame)
  computed by tools/cad/extract_arm01.py from the actuators' cylindrical faces
  (area-weighted), written to tools/cad/arm01_extract.json; copied here.

Mechanism notes
  * J3's actuator is mounted inverted: its output flange is bolted to the
    shoulder side (link2) and its housing rides on the upper arm (link3).
    The joint is the same; the actuator body's mass is in link3, and its
    encoder direction may read -1 (joint config `direction`).
  * J6 drives the wrist pitch through a parallelogram (crank 41.75 mm, lever
    41.75 mm, rod 70.0 mm, ground 69.89 mm), so wrist pitch = J6 motor angle
    1:1 (within 0.2%). wrist_pitch is the pivot (pin) axis through the J7
    centre. The crank and rod are mimic joints of wrist_pitch for display;
    Pinocchio locks them (their 82 g merge into link5).
  * Each actuator's output-face solids belong to the driven link, the rest of
    the actuator to the link holding its housing.

Limits     From the measured ROM: J1 [-80, 200], J2 [0, 190], J3 +-90,
           J4 [0, 130], J5 +-90, J6 +-35, J7 +-90 deg. Effort = model peak
           torque, velocity = model max speed (config/actuator_models.yaml).
           Stage 3 (`arm limits`) finds the hard stops and writes soft limits
           3 deg inside them into the calibration file, not here.

Inertials  PLACEHOLDERS. Volume x density per solid: aluminium 2700 kg/m^3
           for structure, 4500 kg/m^3 for actuators (gives ~0.4 kg per X4),
           steel 7850 for fasteners. Weighed masses go in
           config/arms/arm01.yaml `link_masses_kg`; stage 5 fits each link's
           COM. base_link's inertial is unused (fixed base).

Geometry   visual = collision = the link's STL (one mesh per link, in the link
           frame, made by tools/cad/extract_arm01.py).
================================================================================
-->
<robot name="arm01">

  <material name="frame_grey"><color rgba="0.55 0.57 0.60 1"/></material>
  <material name="arm_white"><color rgba="0.86 0.87 0.88 1"/></material>
  <material name="actuator_dark"><color rgba="0.20 0.21 0.23 1"/></material>
  <material name="tool_orange"><color rgba="0.95 0.55 0.15 1"/></material>

  <!-- =========================================================== base_link -->
  <link name="base_link">
    <inertial>
      <origin xyz="-0.01727 -0.02176 -0.39149" rpy="0 0 0"/>
      <mass value="9.7555"/>
      <inertia ixx="6.1753e-01" ixy="3.6402e-03" ixz="-3.2141e-02" iyy="6.1261e-01" iyz="7.3596e-02" izz="7.2521e-02"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/base_link.stl"/></geometry>
      <material name="frame_grey"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/base_link.stl"/></geometry>
    </collision>
  </link>

  <!-- ================================================================ J1 -->
  <joint name="shoulder_pitch" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="-0.00016 -0.16287 -0.04834" rpy="0 0 0"/>
    <axis xyz="0.00000 -0.86603 0.50000"/>
    <limit lower="-1.39626" upper="3.49066" effort="60.0" velocity="16.0"/>
  </joint>

  <link name="link1">
    <inertial>
      <origin xyz="-0.00116 -0.07674 0.04430" rpy="0 0 0"/>
      <mass value="1.1352"/>
      <inertia ixx="1.4906e-03" ixy="-1.1815e-05" ixz="9.9646e-06" iyy="1.0094e-03" iyz="2.7694e-04" izz="1.3366e-03"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link1.stl"/></geometry>
      <material name="arm_white"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link1.stl"/></geometry>
    </collision>
  </link>

  <!-- ================================================================ J2 -->
  <joint name="shoulder_roll" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="-0.00489 -0.08685 0.04923" rpy="0 0 0"/>
    <axis xyz="-0.98714 -0.07992 -0.13842"/>
    <limit lower="0.0" upper="3.31613" effort="60.0" velocity="16.0"/>
  </joint>

  <link name="link2">
    <inertial>
      <origin xyz="-0.00891 -0.00109 -0.02659" rpy="0 0 0"/>
      <mass value="0.3256"/>
      <inertia ixx="3.5806e-04" ixy="-2.1565e-05" ixz="1.2221e-04" iyy="6.1938e-04" iyz="1.0219e-05" izz="4.0653e-04"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link2.stl"/></geometry>
      <material name="arm_white"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link2.stl"/></geometry>
    </collision>
  </link>

  <!-- ================================================================ J3 -->
  <joint name="shoulder_yaw" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.01827 0.00094 -0.09463" rpy="0 0 0"/>
    <axis xyz="-0.13842 -0.00555 0.99036"/>
    <limit lower="-1.57080" upper="1.57080" effort="34.0" velocity="8.7"/>
  </joint>

  <link name="link3">
    <inertial>
      <origin xyz="0.01735 0.00237 -0.04297" rpy="0 0 0"/>
      <mass value="0.9188"/>
      <inertia ixx="2.2465e-03" ixy="-3.3959e-05" ixz="7.4812e-04" iyy="2.4928e-03" iyz="1.1227e-04" izz="8.5576e-04"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link3.stl"/></geometry>
      <material name="arm_white"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link3.stl"/></geometry>
    </collision>
  </link>

  <!-- ================================================================ J4 -->
  <joint name="elbow" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.04019 0.00256 -0.08903" rpy="0 0 0"/>
    <axis xyz="0.13670 -0.99052 0.01355"/>
    <limit lower="0.0" upper="2.26893" effort="34.0" velocity="8.7"/>
  </joint>

  <link name="link4">
    <inertial>
      <origin xyz="-0.01666 -0.00424 -0.05421" rpy="0 0 0"/>
      <mass value="0.5106"/>
      <inertia ixx="5.8865e-04" ixy="4.0608e-05" ixz="-7.4836e-05" iyy="4.9813e-04" iyz="7.6016e-05" izz="3.5954e-04"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link4.stl"/></geometry>
      <material name="arm_white"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link4.stl"/></geometry>
    </collision>
  </link>

  <!-- ================================================================ J5 -->
  <joint name="forearm_yaw" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="-0.01871 -0.00171 -0.06497" rpy="0 0 0"/>
    <axis xyz="-0.13842 -0.00555 0.99036"/>
    <limit lower="-1.57080" upper="1.57080" effort="34.0" velocity="8.7"/>
  </joint>

  <link name="link5">
    <inertial>
      <origin xyz="0.01011 -0.00064 -0.06526" rpy="0 0 0"/>
      <mass value="0.4555"/>
      <inertia ixx="3.9035e-04" ixy="1.5450e-05" ixz="2.3028e-05" iyy="3.3444e-04" iyz="1.7052e-06" izz="2.2964e-04"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link5.stl"/></geometry>
      <material name="arm_white"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link5.stl"/></geometry>
    </collision>
  </link>

  <!-- ===================================== J6 parallelogram (display only) -->
  <!-- J6's output crank turns with the wrist pitch about the J6 motor axis. -->
  <joint name="wrist_crank_joint" type="revolute">
    <parent link="link5"/>
    <child link="wrist_crank"/>
    <origin xyz="0.00958 -0.00221 -0.06759" rpy="0 0 0"/>
    <axis xyz="0.05069 -0.99871 0.00149"/>
    <limit lower="-0.61087" upper="0.61087" effort="10.0" velocity="24.9"/>
    <mimic joint="wrist_pitch" multiplier="1.0" offset="0.0"/>
  </joint>

  <link name="wrist_crank">
    <inertial>
      <origin xyz="-0.00011 -0.02321 0.00095" rpy="0 0 0"/>
      <mass value="0.0702"/>
      <inertia ixx="1.4100e-05" ixy="-1.3967e-06" ixz="1.2183e-06" iyy="2.9277e-05" iyz="1.6462e-07" izz="1.6743e-05"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/wrist_crank.stl"/></geometry>
      <material name="actuator_dark"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/wrist_crank.stl"/></geometry>
    </collision>
  </link>

  <!-- The rod translates without turning: it counter-rotates on the crank pin. -->
  <joint name="wrist_rod_joint" type="revolute">
    <parent link="wrist_crank"/>
    <child link="wrist_rod"/>
    <origin xyz="-0.03741 -0.03660 0.01438" rpy="0 0 0"/>
    <axis xyz="0.05069 -0.99871 0.00149"/>
    <limit lower="-0.61087" upper="0.61087" effort="10.0" velocity="24.9"/>
    <mimic joint="wrist_pitch" multiplier="-1.0" offset="0.0"/>
  </joint>

  <link name="wrist_rod">
    <inertial>
      <origin xyz="0.00467 0.00080 -0.03401" rpy="0 0 0"/>
      <mass value="0.0117"/>
      <inertia ixx="6.8473e-06" ixy="-2.5417e-09" ixz="9.2871e-07" iyy="7.0390e-06" iyz="-4.9077e-09" izz="2.7216e-07"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/wrist_rod.stl"/></geometry>
      <material name="actuator_dark"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/wrist_rod.stl"/></geometry>
    </collision>
  </link>

  <!-- ================================================================ J6 -->
  <joint name="wrist_pitch" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0.01907 0.00076 -0.13681" rpy="0 0 0"/>
    <axis xyz="0.05069 -0.99871 0.00149"/>
    <limit lower="-0.61087" upper="0.61087" effort="10.0" velocity="24.9"/>
  </joint>

  <link name="link6">
    <inertial>
      <origin xyz="-0.00095 -0.00049 -0.00028" rpy="0 0 0"/>
      <mass value="0.3869"/>
      <inertia ixx="2.0115e-04" ixy="-1.7178e-06" ixz="1.3813e-05" iyy="1.7512e-04" iyz="2.4324e-06" izz="2.1405e-04"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link6.stl"/></geometry>
      <material name="arm_white"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link6.stl"/></geometry>
    </collision>
  </link>

  <!-- ================================================================ J7 -->
  <joint name="wrist_yaw" type="revolute">
    <parent link="link6"/>
    <child link="link7"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0.93828 0.04711 -0.34265"/>
    <limit lower="-1.57080" upper="1.57080" effort="10.0" velocity="24.9"/>
  </joint>

  <link name="link7">
    <inertial>
      <origin xyz="-0.00874 0.00454 -0.05319" rpy="0 0 0"/>
      <mass value="0.3732"/>
      <inertia ixx="6.0782e-04" ixy="1.3314e-06" ixz="-3.0436e-04" iyy="8.1337e-04" iyz="-3.7847e-05" izz="4.0365e-04"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link7.stl"/></geometry>
      <material name="tool_orange"/>
    </visual>
    <collision>
      <geometry><mesh filename="package://wisco_ethercat_ros2_hw/urdf/arm01/meshes/link7.stl"/></geometry>
    </collision>
  </link>

  <!-- ============================================================== frames -->
  <joint name="flange_joint" type="fixed">
    <parent link="link7"/>
    <child link="flange"/>
    <origin xyz="0.02160 0.00108 -0.00789" rpy="3.14159 1.22106 -3.09142"/>
  </joint>
  <link name="flange"/>

  <joint name="tool0_joint" type="fixed">
    <parent link="link7"/>
    <child link="tool0"/>
    <origin xyz="-0.05487 -0.01626 -0.15254" rpy="2.99332 0.33708 -0.04936"/>
  </joint>
  <link name="tool0"/>

</robot>
